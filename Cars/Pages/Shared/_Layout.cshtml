<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171615" />
    <title>@ViewData["Title"] · AUTODOK</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-page="/Index" aria-label="AUTODOK home"><img class="brand-logo" src="~/images/autodok-logo.png" asp-append-version="true" alt="AUTODOK" /></a>
            <nav class="main-nav" aria-label="Main navigation">
                <a asp-page="/Index">Explore cars</a>
                <a asp-page="/Bookings/MyRentals">My rentals</a>
                <a asp-page="/Admin/Index">Admin</a>
            </nav>
        </div>
    </header>
    <main id="main-content">@RenderBody()</main>
    <footer class="site-footer">
        <div class="shell footer-inner">
            <span>AUTODOK</span>
            <address class="footer-address">
                <svg class="footer-address-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>Kawayan Drive, Matina Crossing, Davao City (8000)</span>
            </address>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
